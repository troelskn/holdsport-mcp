#!/usr/bin/env bun
/**
 * holdsport — a tiny CLI for the Holdsport HTTP API.
 *
 * Holdsport is the club management platform RSIK runs on (rosters, schedule,
 * sign-ups). This script talks to its REST API so we can script the boring
 * parts of running the U16 team (headcounts, contact lists, activities).
 *
 * The actual API calls and business logic live in ../src/client.ts (shared with
 * the MCP server in ./holdsport-mcp); terminal rendering lives in
 * ../src/render.ts. This file is just argument parsing and output glue.
 *
 * API docs: https://github.com/Holdsport/holdsport-api
 * Only documented read endpoints are wrapped below — the CLI is read-only and
 * has no raw-request escape hatch.
 *
 * Run with no arguments (or `--help`) for usage.
 *
 * Auth: the Holdsport API uses HTTP Basic auth with your Holdsport login.
 * Provide credentials via environment variables:
 *
 *     export HOLDSPORT_USERNAME="your-login"
 *     export HOLDSPORT_PASSWORD="your-password"
 */

import {
  HoldsportClient,
  loadConfig,
  type Query,
} from "../src/client.ts";
import {
  renderChatRooms,
  renderChatTranscript,
  renderEmail,
  renderEmails,
  renderHeadcount,
  renderHuman,
  rosterCsv,
  rosterTable,
} from "../src/render.ts";

function print(data: unknown): void {
  console.log(typeof data === "string" ? data : JSON.stringify(data, null, 2));
}

/** Print as raw JSON when --json is set, else as a human-readable view. */
function output(
  data: unknown,
  flags: Query,
  opts: { fields?: string[]; maxWidth?: number } = {},
): void {
  if (flags.json) print(data);
  else console.log(renderHuman(data, opts));
}

function fail(message: string): never {
  console.error(`error: ${message}`);
  process.exit(1);
}

/**
 * Split argv into positionals and `--flag value` / `--flag=value` pairs.
 * Bare `--flag` (no value) becomes the string "true".
 */
function parseArgs(argv: string[]): { positional: string[]; flags: Query } {
  const positional: string[] = [];
  const flags: Query = {};

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq !== -1) {
        flags[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else {
        const next = argv[i + 1];
        if (next !== undefined && !next.startsWith("--")) {
          flags[arg.slice(2)] = next;
          i++;
        } else {
          flags[arg.slice(2)] = "true";
        }
      }
    } else {
      positional.push(arg);
    }
  }

  return { positional, flags };
}

function need(args: string[], index: number, label: string): string {
  const value = args[index];
  if (value === undefined) fail(`missing argument: <${label}>`);
  return value;
}

/** The --team override, if given (default team otherwise comes from config). */
function teamOf(flags: Query): string | undefined {
  return flags.team !== undefined ? String(flags.team) : undefined;
}

// --- Commands --------------------------------------------------------------

const USAGE = `holdsport — CLI for the Holdsport API

Usage:
  holdsport <command> [args] [--flags]

Team-scoped commands use HOLDSPORT_TEAM_ID by default; override with --team <id>.
Output is human-readable by default; add --json for raw JSON (roster also has --csv).

Credentials default to the environment (below); override per call with
--user <login> / --pass <password>. Use the login username (not email/member number).

Core commands:
  teams                       List the teams you belong to
  members                     List the team's members (raw JSON)
  member <member_id>          Show a single member
  roster                      Contact list: name/role/mobile/email
                                flags: --players, --staff, --csv
  notes                       List the team's notes
  activities [date]           List the team's activities (date = YYYY-MM-DD, from that day on)
                                flags: --page N --per-page N
  activity <activity_id>      Show a single activity
  attendees <activity_id>     List an activity's attendees (activities_users)
  headcount <activity_id>     Tally attendees by status (flags: --players, --names, --json)
  tasks <activity_id>         List an activity's tasks
  user                        Show the current user profile
  profiles                    List managed profiles

Chat & email:
  chats                       List your chat rooms
  chat <room_id>              Show a room's messages (flags: --limit N)
  emails                      List your inbox (flags: --sent, --limit N)
  email <email_id>            Show a single email (subject, body, attachments)

Other:
  help                        Show this help

Environment:
  HOLDSPORT_USERNAME      Holdsport login username (not email/member no.)
  HOLDSPORT_PASSWORD      Holdsport password
  HOLDSPORT_TEAM_ID       Default team id for team-scoped commands
  HOLDSPORT_ACCESS_TOKEN  Pre-obtained GraphQL token (skips SignIn)
`;

async function main(argv: string[]): Promise<void> {
  const [command, ...rest] = argv;
  const { positional, flags } = parseArgs(rest);

  if (
    command === undefined ||
    command === "help" ||
    command === "-h" ||
    command === "--help"
  ) {
    console.log(USAGE);
    return;
  }

  // Credentials normally come from the environment; these flags override them
  // per call (handy for a one-off or a second account without touching .env).
  const flag = (v: string | number | undefined) =>
    v === undefined ? undefined : String(v);
  const client = new HoldsportClient(
    loadConfig({
      username: flag(flags.user),
      password: flag(flags.pass),
    }),
  );

  switch (command) {
    case "teams":
      return output(await client.listTeams(), flags, {
        fields: ["id", "name", "role"],
      });

    case "members":
      return output(await client.listMembers(teamOf(flags)), flags, {
        fields: [
          "id",
          "firstname",
          "lastname",
          "role",
          "birthday",
          "member_number",
        ],
      });

    case "member": {
      const memberId = need(positional, 0, "member_id");
      return output(await client.getMember(memberId, teamOf(flags)), flags, {
        fields: [
          "id",
          "firstname",
          "lastname",
          "role",
          "birthday",
          "member_number",
        ],
      });
    }

    case "roster": {
      const rows = await client.roster(teamOf(flags), {
        players: Boolean(flags.players),
        staff: Boolean(flags.staff),
      });
      if (flags.json) return print(rows);
      if (flags.csv) return console.log(rosterCsv(rows));
      return console.log(rosterTable(rows));
    }

    case "notes":
      return output(await client.listNotes(teamOf(flags)), flags, {
        fields: ["created_at", "title", "created_by"],
      });

    case "activities":
      return output(
        await client.listActivities(teamOf(flags), {
          date: positional[0],
          page: flags.page,
          perPage: flags["per-page"] ?? flags.per_page,
        }),
        flags,
        { fields: ["id", "starttime", "endtime", "name", "place", "status"] },
      );

    case "activity": {
      const activityId = need(positional, 0, "activity_id");
      return output(
        await client.getActivity(activityId, teamOf(flags)),
        flags,
        {
          fields: [
            "id",
            "name",
            "starttime",
            "endtime",
            "place",
            "pickup_place",
            "pickup_time",
            "status",
            "comment",
          ],
        },
      );
    }

    case "attendees": {
      const activityId = need(positional, 0, "activity_id");
      return output(await client.listAttendees(activityId), flags, {
        fields: ["user_id", "name", "status", "status_code"],
      });
    }

    case "headcount": {
      const activityId = need(positional, 0, "activity_id");
      const hc = await client.headcount(activityId, teamOf(flags), {
        players: Boolean(flags.players),
      });
      if (flags.json) return print(hc);
      return console.log(renderHeadcount(hc, { names: Boolean(flags.names) }));
    }

    case "tasks": {
      const activityId = need(positional, 0, "activity_id");
      return output(await client.listTasks(activityId), flags);
    }

    case "user":
      return output(await client.getUser(), flags, {
        fields: ["id", "firstname", "lastname", "birthday"],
      });

    case "profiles":
      return output(await client.listProfiles(), flags);

    case "chats": {
      const rooms = await client.listChatRooms();
      if (flags.json) return print(rooms);
      return console.log(renderChatRooms(rooms));
    }

    case "chat": {
      const roomId = need(positional, 0, "room_id");
      const limit = flags.limit !== undefined ? Number(flags.limit) : undefined;
      const room = await client.chatRoom(roomId, limit);
      if (flags.json) return print(room);
      return console.log(renderChatTranscript(room));
    }

    case "emails": {
      const limit = flags.limit !== undefined ? Number(flags.limit) : undefined;
      const emails = await client.listEmails({
        sent: Boolean(flags.sent),
        limit,
      });
      if (flags.json) return print(emails);
      return console.log(renderEmails(emails));
    }

    case "email": {
      const emailId = need(positional, 0, "email_id");
      const email = await client.getEmail(emailId);
      if (flags.json) return print(email);
      return console.log(renderEmail(email));
    }

    default:
      fail(`unknown command: ${command}\n\n${USAGE}`);
  }
}

main(process.argv.slice(2)).catch((err) =>
  fail(err instanceof Error ? err.message : String(err)),
);
