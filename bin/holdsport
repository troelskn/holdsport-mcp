#!/usr/bin/env bun
/**
 * holdsport — a tiny CLI for the Holdsport HTTP API.
 *
 * Holdsport is the club management platform RSIK runs on (rosters, schedule,
 * sign-ups). This script talks to its REST API so we can script the boring
 * parts of running the U16 team (headcounts, contact lists, activities).
 *
 * The actual API calls and business logic live in ../src/client.ts (shared with
 * the MCP server in ./holdsport-mcp); terminal rendering lives in
 * ../src/render.ts. This file is just argument parsing and output glue.
 *
 * API docs: https://github.com/Holdsport/holdsport-api
 * Everything is read-only except `activities create` and `activities edit`,
 * which preview by default and only write with an explicit --yes. There is no
 * raw-request escape hatch.
 *
 * Run with no arguments (or `--help`) for usage.
 *
 * Auth: the Holdsport API uses HTTP Basic auth with your Holdsport login.
 * Provide credentials via environment variables:
 *
 *     export HOLDSPORT_USERNAME="your-login"
 *     export HOLDSPORT_PASSWORD="your-password"
 */

import {
  HoldsportClient,
  loadConfig,
  type NewActivity,
  type Query,
  validateNewActivity,
} from "../src/client.ts";
import {
  renderActivities,
  renderActivity,
  renderActivityEdit,
  renderChatRooms,
  renderChatTranscript,
  renderEmail,
  renderEmails,
  renderHuman,
  renderNewActivity,
  rosterCsv,
  rosterTable,
} from "../src/render.ts";

function print(data: unknown): void {
  console.log(typeof data === "string" ? data : JSON.stringify(data, null, 2));
}

/** Print as raw JSON when --json is set, else as a human-readable view. */
function output(
  data: unknown,
  flags: Query,
  opts: { fields?: string[]; maxWidth?: number } = {},
): void {
  if (flags.json) print(data);
  else console.log(renderHuman(data, opts));
}

function fail(message: string): never {
  console.error(`error: ${message}`);
  process.exit(1);
}

/**
 * Split argv into positionals and `--flag value` / `--flag=value` pairs.
 * Bare `--flag` (no value) becomes the string "true".
 */
function parseArgs(argv: string[]): { positional: string[]; flags: Query } {
  const positional: string[] = [];
  const flags: Query = {};

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq !== -1) {
        flags[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else {
        const next = argv[i + 1];
        if (next !== undefined && !next.startsWith("--")) {
          flags[arg.slice(2)] = next;
          i++;
        } else {
          flags[arg.slice(2)] = "true";
        }
      }
    } else {
      positional.push(arg);
    }
  }

  return { positional, flags };
}

function need(args: string[], index: number, label: string): string {
  const value = args[index];
  if (value === undefined) fail(`missing argument: <${label}>`);
  return value;
}

/** The --team override, if given (default team otherwise comes from config). */
function teamOf(flags: Query): string | undefined {
  return flags.team !== undefined ? String(flags.team) : undefined;
}

/**
 * The activity fields given as flags, as a sparse Partial<NewActivity>.
 * `activities create` requires name/date/start among them; `activities edit`
 * takes any subset.
 */
function activityFieldFlags(flags: Query): Partial<NewActivity> {
  const str = (v: string | number | undefined) =>
    v === undefined ? undefined : String(v);
  return {
    name: str(flags.name),
    date: str(flags.date),
    start_time: str(flags.start),
    end_time: str(flags.end),
    end_date: str(flags["end-date"]),
    meeting_time: str(flags.meet),
    place: str(flags.place),
    comment: str(flags.comment),
    event_type_id:
      flags["event-type"] !== undefined ? Number(flags["event-type"]) : undefined,
    max_attendees: flags.max !== undefined ? Number(flags.max) : undefined,
    // Free text here; validateNewActivity rejects anything but the known names.
    registration_type: str(flags["registration-type"]) as
      | NewActivity["registration_type"]
      | undefined,
  };
}

// --- Commands --------------------------------------------------------------

const USAGE = `holdsport — CLI for the Holdsport API

Usage:
  holdsport <command> [args] [--flags]

Team-scoped commands use HOLDSPORT_TEAM_ID by default; override with --team <id>.
Output is human-readable by default; add --json for raw JSON (roster also has --csv).

Credentials default to the environment (below); override per call with
--user <login> / --pass <password>. Use the login username (not email/member number).

List commands take an optional id to show one item instead (e.g. activities 1234).

Core commands:
  teams                       List the teams you belong to
  members [member_id]         List the team's members; with an id, show that member
  roster                      Contact list: name/role/mobile/email
                                flags: --players, --staff, --csv
  notes                       List the team's notes
  activities [date|id]        Upcoming activities: type, place, sign-up count
                                (date YYYY-MM-DD = from that day; flags: --page N)
                                with an id: that activity + attendance (flags: --names)
  activities create           Create an activity — WRITES to Holdsport.
                                Previews and exits by default; add --yes to create.
                                required: --name <text> --date YYYY-MM-DD --start HH:MM
                                optional: --end HH:MM, --end-date YYYY-MM-DD, --meet HH:MM,
                                          --place <text>, --comment <text>,
                                          --event-type <id>, --max <n>,
                                          --registration-type <t>  (sign-up mode: normal,
                                            pick_out, available, everybody_attending,
                                            pick_out_sub_teams, no_registration)
  activities edit <id>        Edit an activity — WRITES to Holdsport.
                                Takes any subset of the create flags; unmentioned fields
                                keep their values. Previews an old → new diff by default;
                                add --yes to apply. For a repeating activity only that
                                occurrence is changed — never the rest of the series.
  event-types                 List the team's activity event types (ids for --event-type)
  tasks <activity_id>         List an activity's tasks
  user                        Show the current user profile
  profiles                    List managed profiles

Chat & email:
  chats [room_id]             List your chat rooms; with an id, show that room (flags: --limit N)
  emails [email_id]           List your inbox (flags: --sent, --limit N); with an id, show that email

Other:
  help                        Show this help

Environment:
  HOLDSPORT_USERNAME      Holdsport login username (not email/member no.)
  HOLDSPORT_PASSWORD      Holdsport password
  HOLDSPORT_TEAM_ID       Default team id for team-scoped commands
`;

async function main(argv: string[]): Promise<void> {
  const [command, ...rest] = argv;
  const { positional, flags } = parseArgs(rest);

  if (
    command === undefined ||
    command === "help" ||
    command === "-h" ||
    command === "--help"
  ) {
    console.log(USAGE);
    return;
  }

  // Credentials normally come from the environment; these flags override them
  // per call (handy for a one-off or a second account without touching .env).
  const flag = (v: string | number | undefined) =>
    v === undefined ? undefined : String(v);
  const client = new HoldsportClient(
    loadConfig({
      username: flag(flags.user),
      password: flag(flags.pass),
    }),
  );

  switch (command) {
    case "teams":
      return output(await client.listTeams(), flags, {
        fields: ["id", "name", "role"],
      });

    case "members": {
      const fields = [
        "id",
        "firstname",
        "lastname",
        "role",
        "birthday",
        "member_number",
      ];
      const memberId = positional[0];
      // With an id, show that one member; otherwise list them all.
      const data = memberId
        ? await client.getMember(memberId, teamOf(flags))
        : await client.listMembers(teamOf(flags));
      return output(data, flags, { fields });
    }

    case "roster": {
      const rows = await client.roster(teamOf(flags), {
        players: Boolean(flags.players),
        staff: Boolean(flags.staff),
      });
      if (flags.json) return print(rows);
      if (flags.csv) return console.log(rosterCsv(rows));
      return console.log(rosterTable(rows));
    }

    case "notes":
      return output(await client.listNotes(teamOf(flags)), flags, {
        fields: ["created_at", "title", "created_by"],
      });

    case "activities": {
      // A YYYY-MM-DD arg is a list start-date; "create"/"edit" write; any
      // other arg is an activity id.
      const arg = positional[0];
      if (arg === "create") {
        const fields = activityFieldFlags(flags);
        for (const [field, flagName] of [
          ["name", "name"],
          ["date", "date"],
          ["start_time", "start"],
        ] as const) {
          if (fields[field] === undefined) fail(`missing required flag: --${flagName}`);
        }
        const activity = fields as NewActivity;
        // Validate even the dry run, so a bad payload is caught before --yes.
        validateNewActivity(activity);
        if (!flags.yes) {
          console.log(renderNewActivity(activity));
          console.log("\nDry run — nothing created. Re-run with --yes to create this activity.");
          return;
        }
        const created = await client.createActivity(activity, teamOf(flags));
        if (flags.json) return print(created);
        return console.log(`Created:\n\n${renderActivities([created])}`);
      }
      if (arg === "edit") {
        const id = need(positional, 1, "activity_id");
        const changes = Object.fromEntries(
          Object.entries(activityFieldFlags(flags)).filter(([, v]) => v !== undefined),
        ) as Partial<NewActivity>;
        if (Object.keys(changes).length === 0) {
          fail("nothing to change: pass at least one field flag (--name, --date, --start, …)");
        }
        if (flags.scope !== undefined) {
          fail(
            "--scope is not supported: edits always change only this occurrence — " +
              "series-wide edits are deliberately left to the Holdsport app",
          );
        }
        if (!flags.yes) {
          // The dry run reads the activity (a read, no write) to diff against.
          const current = await client.activityForEdit(id);
          const merged: NewActivity = { ...current.fields, ...changes };
          validateNewActivity(merged);
          console.log(renderActivityEdit(current.fields, merged));
          if (current.is_repeated) {
            console.log(
              "\nThis activity repeats — only this occurrence will be changed; " +
                "the rest of the series is untouched.",
            );
          }
          console.log("\nDry run — nothing changed. Re-run with --yes to apply.");
          return;
        }
        // Deliberately hardcoded to this one occurrence: series-wide edits stay
        // in the app, where the save dialog makes the blast radius explicit.
        const updated = await client.updateActivity(id, changes, {
          repeatScope: "this",
        });
        if (flags.json) return print(updated);
        return console.log(`Updated:\n\n${renderActivities([updated])}`);
      }
      if (arg !== undefined && !/^\d{4}-\d{2}-\d{2}$/.test(arg)) {
        const detail = await client.getActivity(arg);
        if (flags.json) return print(detail);
        return console.log(renderActivity(detail, { names: Boolean(flags.names) }));
      }
      const rows = await client.listActivities({
        teamId: teamOf(flags),
        date: arg,
        page: flags.page !== undefined ? Number(flags.page) : undefined,
      });
      if (flags.json) return print(rows);
      return console.log(renderActivities(rows));
    }

    case "event-types":
      return output(await client.listEventTypes(teamOf(flags)), flags, {
        fields: ["id", "name", "color"],
      });

    case "tasks": {
      const activityId = need(positional, 0, "activity_id");
      return output(await client.listTasks(activityId), flags);
    }

    case "user":
      return output(await client.getUser(), flags, {
        fields: ["id", "firstname", "lastname", "birthday"],
      });

    case "profiles":
      return output(await client.listProfiles(), flags);

    case "chats": {
      // With a room id, show that room's transcript; otherwise list rooms.
      const roomId = positional[0];
      if (roomId !== undefined) {
        const limit = flags.limit !== undefined ? Number(flags.limit) : undefined;
        const room = await client.chatRoom(roomId, limit);
        if (flags.json) return print(room);
        return console.log(renderChatTranscript(room));
      }
      const rooms = await client.listChatRooms();
      if (flags.json) return print(rooms);
      return console.log(renderChatRooms(rooms));
    }

    case "emails": {
      // With an email id, show that email; otherwise list the inbox/sent box.
      const emailId = positional[0];
      if (emailId !== undefined) {
        const email = await client.getEmail(emailId);
        if (flags.json) return print(email);
        return console.log(renderEmail(email));
      }
      const limit = flags.limit !== undefined ? Number(flags.limit) : undefined;
      const emails = await client.listEmails({ sent: Boolean(flags.sent), limit });
      if (flags.json) return print(emails);
      return console.log(renderEmails(emails));
    }

    default:
      fail(`unknown command: ${command}\n\n${USAGE}`);
  }
}

main(process.argv.slice(2)).catch((err) =>
  fail(err instanceof Error ? err.message : String(err)),
);
